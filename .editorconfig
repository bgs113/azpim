root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go requires tabs
[*.go]
indent_style = tab
indent_size = 4

# Use spaces for everything else
[*.{yaml,yml,json,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# Trailing spaces are meaningful in Markdown (line breaks)
[*.md]
trim_trailing_whitespace = false
